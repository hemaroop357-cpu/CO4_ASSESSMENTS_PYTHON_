from pathlib import Path
import shutil
import sys


def setup_sample_attendance(base_dir: Path):
    """Create 4 days of sample attendance files where 192311002 is absent for 3 consecutive days."""
    if base_dir.exists():
        shutil.rmtree(base_dir)
    base_dir.mkdir(parents=True)

    days = {
        "2026-10-01.txt": "192311001,P\n192311002,P\n192311003,A\n",
        "2026-10-02.txt": "192311001,P\n192311002,A\n192311003,P\n",
        "2026-10-03.txt": "192311001,A\n192311002,A\n192311003,P\n",
        "2026-10-04.txt": "192311001,P\n192311002,A\n192311003,P\n",
    }
    for filename, content in days.items():
        (base_dir / filename).write_text(content, encoding="utf-8")


