SINGLE_SCRIPT_CODE = '''from pathlib import Path


def read_records(folder_path):
    records = []
    for file_path in sorted(Path(folder_path).glob("*.txt")):
        day = file_path.stem
        with file_path.open("r", encoding="utf-8") as f:
            for line in f:
                parts = [p.strip() for p in line.strip().split(",")]
                if len(parts) == 2 and parts[1] in ("P", "A"):
                    records.append((day, parts[0], parts[1]))
    return records


def compute_stats(records):
    counts = {}
    for _, reg_no, status in records:
        if reg_no not in counts:
            counts[reg_no] = {"P": 0, "A": 0}
        counts[reg_no][status] += 1

    percentages = {}
    for reg_no, c in counts.items():
        total = c["P"] + c["A"]
        percentages[reg_no] = (c["P"] / total * 100.0) if total else 0.0
    return percentages


def find_consecutive_absentees(records, streak_limit=3):
    by_student = {}
    for day, reg_no, status in records:
        by_student.setdefault(reg_no, []).append((day, status))

    flagged = []
    for reg_no, day_statuses in sorted(by_student.items()):
        day_statuses.sort(key=lambda item: item[0])
        streak = 0
        for _, status in day_statuses:
            if status == "A":
                streak += 1
                if streak >= streak_limit and reg_no not in flagged:
                    flagged.append(reg_no)
            else:
                streak = 0
    return flagged


def write_reports(percentages, streak_students, out_dir):
    out = Path(out_dir)
    out.mkdir(parents=True, exist_ok=True)
    with (out / "summary.txt").open("w", encoding="utf-8") as f:
        for reg_no, pct in sorted(percentages.items()):
            f.write(f"{reg_no}: {pct:.2f}%\\n")

    with (out / "consecutive_absent_3d.txt").open("w", encoding="utf-8") as f:
        for reg_no in streak_students:
            f.write(f"{reg_no}\\n")


if __name__ == "__main__":
    recs = read_records("sample_days")
    pcts = compute_stats(recs)
    streaks = find_consecutive_absentees(recs, 3)
    write_reports(pcts, streaks, "out_single")
    print("[Single Script] 3+ consecutive absentees:", streaks)
'''


