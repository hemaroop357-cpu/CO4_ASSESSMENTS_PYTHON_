def build_and_run_all():
    work_dir = Path("task5_demo")
    if work_dir.exists():
        shutil.rmtree(work_dir)
    work_dir.mkdir()

    setup_sample_attendance(work_dir / "sample_days")

    # (a)
    (work_dir / "single_script_attendance.py").write_text(SINGLE_SCRIPT_CODE, encoding="utf-8")

    # (b)
    (work_dir / "attendance_util.py").write_text(MODULE_B_CODE, encoding="utf-8")
    (work_dir / "main_b.py").write_text(MAIN_B_CODE, encoding="utf-8")

    # (c)
    (work_dir / "reader.py").write_text(READER_CODE, encoding="utf-8")
    (work_dir / "stats.py").write_text(STATS_CODE, encoding="utf-8")
    (work_dir / "report.py").write_text(REPORT_CODE, encoding="utf-8")
    (work_dir / "main_c.py").write_text(MAIN_C_CODE, encoding="utf-8")

    # (d)
    pkg_dir = work_dir / "attendance"
    pkg_dir.mkdir()
    (pkg_dir / "__init__.py").write_text(INIT_CODE, encoding="utf-8")
    (pkg_dir / "reader.py").write_text(READER_CODE, encoding="utf-8")
    (pkg_dir / "stats.py").write_text(STATS_CODE, encoding="utf-8")
    (pkg_dir / "report.py").write_text(REPORT_CODE, encoding="utf-8")
    (work_dir / "main_d.py").write_text(MAIN_D_CODE, encoding="utf-8")

    # Execute all four inside work_dir
    sys.path.insert(0, str(work_dir))
    import os
    prev_cwd = os.getcwd()
    os.chdir(work_dir)
    try:
        exec(compile(Path("single_script_attendance.py").read_text(), "single_script_attendance.py", "exec"), {"__name__": "__main__"})
        exec(compile(Path("main_b.py").read_text(), "main_b.py", "exec"), {"__name__": "__main__"})
        exec(compile(Path("main_c.py").read_text(), "main_c.py", "exec"), {"__name__": "__main__"})
        exec(compile(Path("main_d.py").read_text(), "main_d.py", "exec"), {"__name__": "__main__"})
    finally:
        os.chdir(prev_cwd)


if __name__ == "__main__":
    build_and_run_all()
